            <column-instance column='[Calculation_1475834159521794]' derivation='User' name='[usr:Calculation_1475834159521794:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Rows' />
              <table-calc field='[federated.0dl7zxj1s4nkrj16ow16c1rp59gb].[Calculation_1475833849094145]' ordering-type='Rows' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0dl7zxj1s4nkrj16ow16c1rp59gb].[none:Customer Name:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
