      <aliases enabled='yes' />
      <column caption='Profit Margin' datatype='real' name='[Calculation_0718546596872192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='LOD 3 months Moving Average' datatype='real' default-format='c&quot;$&quot;#,##0,K;(&quot;$&quot;#,##0,K)' name='[Calculation_0718546636304385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales]' />
      </column>
      <column caption='delivery days' datatype='integer' name='[Calculation_1388699020566529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,DATETRUNC(&apos;day&apos;,[Order Date]),DATETRUNC(&apos;day&apos;,[Ship Date]))' />
      </column>
      <column caption='Cumalative Sales%' datatype='real' name='[Calculation_1475833849094145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))/TOTAL(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cumalative Sales ' datatype='string' name='[Calculation_1475834159521794]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF[Calculation_1475833849094145]&lt;=0.8 THEN&quot;Top 80%&quot; ELSE&quot;Remaining 20%&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='Orders per Customer' datatype='integer' name='[Calculation_1475834268270595]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [Customer Name]: COUNTD([Order ID])}' />
      </column>
