            <column-instance column='[Sales]' derivation='Sum' name='[pcto:cum:sum:Sales:qk:9]' pivot='key' type='quantitative'>
              <table-calc aggregation='Sum' ordering-type='Rows' type='CumTotal' />
              <table-calc ordering-type='Field' type='PctTotal'>
                <order field='[federated.0dl7zxj1s4nkrj16ow16c1rp59gb].[none:Customer Name:nk]' />
                <sort direction='DESC' using='[federated.0dl7zxj1s4nkrj16ow16c1rp59gb].[sum:Sales:qk]' />
              </table-calc>
            </column-instance>
